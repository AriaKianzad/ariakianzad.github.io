# ============================================================
# ariakianzad.ir - Apache/cPanel configuration (static site)
#
# The site is a fully static export: index.html, a custom 404 page,
# hashed CSS/font assets, and two same-origin scripts. There is no
# backend and PHP never executes.
#
# Required modules: mod_headers (security headers + cache rules).
# Optional: mod_rewrite (HTTPS + canonical-host redirects),
# mod_deflate + mod_filter (compression), mod_mime (MIME types).
# Every non-core directive is guarded by <IfModule>, so a server
# without an optional module still serves the site instead of
# failing with HTTP 500. See HOSTING-README.txt.
# ============================================================

# --- Defaults -------------------------------------------------
DirectoryIndex index.html
# NOTE on the line below: 'Options' is a core Apache directive whose
# permission depends on the server's AllowOverride setting. Standard
# cPanel (AllowOverride All) permits it; a host that restricts
# .htaccess would answer every request with HTTP 500 because of it.
# If a 500 appears right after deploy, remove this line and ask the
# provider to disable directory listings server-side instead.
Options -Indexes -MultiViews
AddDefaultCharset utf-8

# --- Custom error page ----------------------------------------
ErrorDocument 404 /404.html

# --- MIME types ------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# --- HTTPS + canonical host (ariakianzad.ir, no www) ------------
# Redirects every request to https://ariakianzad.ir (canonical
# origin used by the canonical link, Open Graph tags, and
# sitemap.xml). The rule fires only when HTTPS is off OR the host
# is anything other than ariakianzad.ir, so it cannot loop.
#
# NOTE: leave these lines enabled only once SSL/TLS is active for
# the domain (cPanel AutoSSL). If the certificate is not issued
# yet, comment out the whole block (5 lines between BEGIN/END),
# finish SSL setup, then re-enable it.
# BEGIN HTTPS + canonical host
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^ariakianzad\.ir$ [NC]
  RewriteRule ^ https://ariakianzad.ir%{REQUEST_URI} [R=301,L,QSA,NE]
</IfModule>
# END HTTPS + canonical host
# If TLS is terminated at a proxy/load balancer (the backend sees
# plain HTTP on every request, which would loop above), replace the
# first condition with:
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https

# --- Security headers -------------------------------------------
# Same policy as public/_headers (kept in sync; both files are
# cross-checked by scripts/verify-export.mjs on every build).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HTTP Strict Transport Security. Uncomment ONLY when HTTPS is confirmed
  # working on the domain (and any subdomains): browsers then refuse plain
  # HTTP for a full year. The 'preload' token additionally commits the
  # domain to the HSTS preload list - remove it unless you intend that.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # --- Caching (filename-scoped, correct for this artifact) ------
  # HTML: always revalidate.
  <FilesMatch "\.html?$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Hashed framework assets (the only .css/.woff2 files are under
  # /_next/static/ with content-hashed names): cache forever.
  <FilesMatch "\.(css|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Site scripts (boot.js, ui.js are NOT content-hashed): short cache.
  <FilesMatch "\.js$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Icons and the social image (fixed names): one week.
  <FilesMatch "\.(png|ico)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # SEO text files: revalidate hourly.
  <FilesMatch "\.(txt|xml)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------
# Requires both mod_deflate and (in Apache 2.4) mod_filter for
# AddOutputFilterByType; guarded so a partial setup cannot 500.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml text/plain text/xml application/xml application/ld+json
  </IfModule>
</IfModule>
