# Security headers for ariakianzad.ir - applied by the hosting layer (e.g.
# Netlify or Cloudflare Pages). A strict CSP with no 'unsafe-inline': the same-origin
# scripts are public/boot.js, public/ui.js, and public/analytics-consent.js; styles are
# same-origin files plus hashed inline next/font face rules, whose hashes are
# appended to style-src at build time by scripts/strip-next-runtime.mjs.
#
# HSTS is intentionally omitted from this default policy. Consider enabling
# it only after HTTPS is confirmed on the domain and every subdomain; do not
# use the preload token without a deliberate, long-term decision.
#
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://bkohdqwecnvbmeaiuyyx.supabase.co https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Immutable: every URL below is content-hashed, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The hero entrypoint is a stable filename; keep it on a short revalidation cache.
/_hero/*
  Cache-Control: public, max-age=3600, must-revalidate

# The split Three.js chunk is content-hashed and safe to cache immutably.
/_hero/chunks/*
  Cache-Control: public, max-age=31536000, immutable
