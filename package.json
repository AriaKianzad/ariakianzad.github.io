{
  "name": "aria-kianzad-site",
  "version": "1.0.0",
  "private": true,
  "description": "Aria Kianzad's personal website and Persian book microsite, built as a static export.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/strip-next-runtime.mjs && esbuild src/client/hero-visual.ts src/client/home-scenes.ts --bundle --splitting --format=esm --target=es2020 --outdir=out/_hero --entry-names=[name] --chunk-names=chunks/[name]-[hash] && esbuild --allow-overwrite --minify out/boot.js out/ui.js --outdir=out && node scripts/generate-social-previews.mjs && node scripts/verify-export.mjs",
    "hosting": "node scripts/make-hosting-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "preview": "node scripts/serve.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "social-icons": "node scripts/extract-social-paths.mjs",
    "check:security": "node scripts/verify-secrets.mjs",
    "test:consent": "node scripts/test-analytics-consent.mjs",
    "test:homepage": "node scripts/test-homepage-contract.mjs",
    "test:supabase": "node scripts/test-supabase-contract.mjs",
    "test:analytics": "node scripts/test-google-analytics-contract.mjs",
    "test:security-scan": "node scripts/test-security-scan.mjs",
    "test:build-safety": "node scripts/test-build-safety.mjs",
    "prebuild": "npm run assets && node scripts/fetch-blog-content.mjs && node scripts/generate-blog-og.mjs",
    "predev": "npm run assets && node scripts/fetch-blog-content.mjs && node scripts/generate-blog-og.mjs",
    "test:blog": "node scripts/test-blog-contract.mjs",
    "test:editor": "node scripts/test-blog-editor-contract.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.6",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "wawoff2": "^1.0.2"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.9"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.9"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    }
  }
}
