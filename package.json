{
  "name": "aria-kianzad-site",
  "version": "1.0.0",
  "private": true,
  "description": "Aria Kianzad — brand strategist & copywriter. Single-page personal website, statically exported.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/strip-next-runtime.mjs && esbuild --allow-overwrite --minify out/boot.js out/ui.js --outdir=out && node scripts/verify-export.mjs",
    "hosting": "node scripts/make-hosting-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "opentype.js": "^1.3.4",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "wawoff2": "^1.0.2"
  }
}
